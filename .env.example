# local binds only loopback. server exposes HTTPS through Caddy.
DEPLOYMENT=local
PUBLIC_BASE_URL=http://127.0.0.1:8080
DATA_ROOT=
BACKUP_ROOT=
ADMIN_USERNAME=token
ADMIN_PASSWORD_HASH=
UPLOAD_TOKEN_HASH=
UPLOAD_TOKEN_ENABLED=true
POSTGRES_DB=tokenlibrary
POSTGRES_USER=tokenlibrary
POSTGRES_PASSWORD=
# Optional existing PostgreSQL data directory; defaults to DATA_ROOT/postgres.
POSTGRES_DATA_ROOT=
ACME_EMAIL=
# Optional: use Let's Encrypt staging only while testing certificate issuance.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
APP_UID=10001
APP_GID=10001
BACKUP_TIME=03:00
BACKUP_TIMEZONE=Asia/Shanghai
BACKUP_TIMEOUT=20m
LOG_LEVEL=info
TOKENLIBRARY_TEST_HOOKS=0
CREDENTIAL_GENERATION=1
# App version shown in Settings. Change these, then rebuild the iPhone or Mac app.
APP_VERSION=1.0.0
APP_BUILD=1
