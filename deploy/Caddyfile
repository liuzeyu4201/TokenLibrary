{
	admin off
	email {$ACME_EMAIL}
}

https://{$TLS_HOST} {
	tls {
		issuer acme {
			dir {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
			profile shortlived
		}
	}
	request_body {
		max_size 55MB
	}
	reverse_proxy app:8080 {
		health_uri /health/ready
		health_interval 10s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}
